# Default-off rollout control for HOAHUB-UX-P0-001. Targets are JSON and may
# combine tenantIds, modules, roles, or explicit ordered rules.
UX_ACTION_PROGRESS_V1_ENABLED=false
UX_ACTION_PROGRESS_V1_TARGETS={"global":false}

NODE_ENV="production"
APP_URL="https://hoahub.tech"
PUBLIC_APP_URL="https://hoahub.tech"
BASE_URL="https://hoahub.tech"
API_URL="https://hoahub.tech/api"
ALLOWED_ORIGINS="https://hoahub.tech"
WEBAUTHN_RP_ID="hoahub.tech"
WEBAUTHN_ORIGIN="https://hoahub.tech"

# Local UAT WebAuthn values:
# APP_URL="http://localhost:3000"
# PUBLIC_APP_URL="http://localhost:3000"
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGIN="http://localhost:3000"
#
# Production WebAuthn values:
# APP_URL="https://hoahub.tech"
# PUBLIC_APP_URL="https://hoahub.tech"
# WEBAUTHN_RP_ID="hoahub.tech"
# WEBAUTHN_ORIGIN="https://hoahub.tech"

DATABASE_URL="mysql://<MYSQL_USER>:<URL_ENCODED_MYSQL_PASSWORD>@<MYSQL_HOST>:3306/<MYSQL_DATABASE>"
ALLOW_LOCAL_ORIGINS="false"
AUTH_SECRET="<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>"
SESSION_MAX_AGE_SECONDS="28800"
CRON_SECRET="<GENERATE_A_SEPARATE_RANDOM_CRON_SECRET>"
MONTHLY_DUES_DUE_DAY="15"
ENABLE_APPROVED_PASS_TEMPLATE_INSTALLER="false"

# HOAHub AI Assistance.
# Keep OPENAI_API_KEY server-side only in Hostinger/GitHub secrets or local ignored env files.
AI_RUNTIME_ENABLED="false"
AI_PROVIDER_MODE="openai"
OPENAI_API_KEY=""
OPENAI_MODEL_ECONOMY="gpt-5-nano"
OPENAI_MODEL_STANDARD="gpt-5-mini"
OPENAI_MODEL_PREMIUM="gpt-5"
OPENAI_ESTIMATED_INPUT_CENTAVOS_PER_1K_TOKENS=""
OPENAI_ESTIMATED_OUTPUT_CENTAVOS_PER_1K_TOKENS=""

SEED_SYSTEM_ADMIN_NAME="System Administrator"
SEED_SYSTEM_ADMIN_EMAIL=""
SEED_SYSTEM_ADMIN_PASSWORD=""

MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USERNAME="support@hoahub.tech"
SMTP_PASSWORD="<HOSTINGER_EMAIL_PASSWORD>"
SMTP_ENCRYPTION="ssl"
SMTP_ALLOW_DIFFERENT_FROM_ADDRESS="false"
MAIL_FROM_ADDRESS="support@hoahub.tech"
MAIL_FROM_NAME="HOAHUB"
MAIL_REPLY_TO="support@hoahub.tech"

# P0 email-delivery safety controls. Bulk billing/reminder delivery is deliberately
# fail-closed after deploy. Enable only after the SMTP mailbox is restored,
# Verify Connection succeeds, and a controlled valid-recipient canary is clean.
EMAIL_BULK_DELIVERY_ENABLED="false"
# Per-tenant queue rows drained per protected worker invocation (1-100).
EMAIL_DELIVERY_BATCH_SIZE="25"
# Minimum delay between bulk SMTP attempts in one worker process (0-5000 ms).
EMAIL_DELIVERY_MIN_INTERVAL_MS="500"

PASSWORD_RESET_EXPIRY_MINUTES="60"
PASSWORD_MIN_LENGTH="10"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBER="true"
PASSWORD_REQUIRE_SPECIAL="true"

PAYMENT_INSTRUCTIONS="Pay using the official HOA payment instructions and include the correct billing reference."

# HOAHub platform subscription invoice issuer details.
# Optional values appear on professional printable/downloadable tenant invoices.
PLATFORM_BILLING_LEGAL_NAME="HOAHub"
PLATFORM_BILLING_ADDRESS=""
PLATFORM_BILLING_EMAIL="support@hoahub.tech"
PLATFORM_BILLING_CONTACT_NUMBER=""
PLATFORM_BILLING_TIN=""
PLATFORM_BILLING_WEBSITE="hoahub.tech"

# HOAHub platform subscription payments (tenant -> HOAHub SaaS billing).
# Keep these server-side only. Register this webhook in the HOAHub platform
# PayMongo merchant and subscribe to checkout_session.payment.paid:
# https://hoahub.tech/api/platform/billing/webhooks/paymongo
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_CHECKOUT_METHODS="card,gcash,paymaya,qrph"

# Homeowner -> HOA tenant collections through PayMongo Linked Accounts.
# This is the parent/platform secret key. HOAHub sends each tenant's org_...
# identifier as Account-ID so Checkout Sessions are created on behalf of that
# child merchant. When PayMongo Online is enabled for a tenant, HOAHub creates
# or enables a child-scoped webhook and stores that endpoint's signing secret
# as a tenant secret setting; there is intentionally no global homeowner
# webhook secret environment variable.
PAYMONGO_HOMEOWNER_SECRET_KEY=""
PAYMONGO_HOMEOWNER_CHECKOUT_METHODS="card,gcash,paymaya,qrph"
# Transactional org_... ID of HOAHub's parent PayMongo merchant. This is not
# the API secret. It is required only when a platform-owned homeowner
# convenience fee is enabled, so PayMongo can split that fixed fee to HOAHub
# and transfer the remaining net amount to the tenant child merchant.
PAYMONGO_HOMEOWNER_PARENT_ACCOUNT_ID=""

FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_API_VERSION="v23.0"

STORAGE_ROOT="/home/<HOSTINGER_USERNAME>/domains/hoahub.tech/storage"
UPLOAD_MAX_SIZE_MB="10"
