NODE_ENV="development"
APP_URL="http://localhost:3000"
DATABASE_URL="mysql://hoa_app:hoa_local_password@127.0.0.1:3306/hoa_portal"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SESSION_MAX_AGE_SECONDS="28800"
SEED_SYSTEM_ADMIN_NAME="System Administrator"
SEED_SYSTEM_ADMIN_EMAIL=""
SEED_SYSTEM_ADMIN_PASSWORD=""
MAIL_PROVIDER="gmail"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME="<YOUR_EMAIL_ADDRESS>"
MAIL_PASSWORD="<YOUR_GOOGLE_APP_PASSWORD>"
MAIL_ENCRYPTION="tls"
MAIL_FROM_NAME="HOA Digital Hub"
MAIL_FROM_ADDRESS="<YOUR_EMAIL_ADDRESS>"
PASSWORD_RESET_EXPIRY_MINUTES="60"
PASSWORD_MIN_LENGTH="10"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBER="true"
PASSWORD_REQUIRE_SPECIAL="true"
PAYMENT_INSTRUCTIONS="Pay at the HOA office or transfer to the association account. Include your bill reference."
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_API_VERSION="v23.0"
STORAGE_ROOT="storage"
UPLOAD_MAX_SIZE_MB="10"
