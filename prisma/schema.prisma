model ComplaintAssignment {
  tenantId     String    @default("tenant_pagsibol4b_default")
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  assigneeId   String
  assignee     User      @relation("ComplaintAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   User?     @relation("ComplaintAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  roleLabel    String?
  active       Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, complaintId, active])
  @@index([assigneeId, active])
  @@index([assignedById])
}

model ComplaintIdentityAccessGrant {
  tenantId      String                        @default("tenant_pagsibol4b_default")
  id            String                        @id @default(cuid())
  complaintId   String
  complaint     Complaint                     @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  requestedById String
  requestedBy   User                          @relation("ComplaintIdentityAccessRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?                         @relation("ComplaintIdentityAccessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  status        ComplaintIdentityAccessStatus @default(REQUESTED)
  purpose       String
  reason        String                        @db.Text
  expiresAt     DateTime?
  decidedAt     DateTime?
  createdAt     DateTime                      @default(now())
  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, complaintId, status])
  @@index([requestedById, status])
  @@index([approvedById])
}

model UserSession {
  tenantId      String    @default("tenant_pagsibol4b_default")
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  userAgentHash String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?

  @@index([tenantId, userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@index([tenantId])
}

model SystemSetting {
  tenantId    String                @default("tenant_pagsibol4b_default")
  id          String                @id @default(cuid())
  category    SystemSettingCategory
  key         String
  label       String
  value       String?               @db.Text
  isSecret    Boolean               @default(false)
  updatedById String?
  updatedBy   User?                 @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([tenantId, category, key])
  @@index([category])
  @@index([updatedById])
  @@index([tenantId])
}

model PaymentRequest {
  tenantId          String               @default("tenant_pagsibol4b_default")
  id                String               @id @default(cuid())
  type              PaymentRequestType
  status            PaymentRequestStatus @default(PENDING_REVIEW)
  homeownerId       String
  homeowner         HomeownerProfile     @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  billId            String?
  bill              Bill?                @relation(fields: [billId], references: [id], onDelete: Restrict)
  documentRequestId String?
  documentRequest   DocumentRequest?     @relation(fields: [tenantId, documentRequestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  collectionType    CollectionType?
  description       String?
  amount            Decimal              @db.Decimal(12, 2)
  paymentDate       DateTime             @db.Date
  method            PaymentMethod        @default(GCASH)
  referenceNumber   String?
  proofImageUrl     String?
  proofFileName     String?
  proofContentType  String?
  proofFileSize     Int?
  payerNotes        String?
  reviewRemarks     String?
  reviewedById      String?
  reviewedBy        User?                @relation("PaymentRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  paymentId         String?              @unique
  payment           Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  collectionId      String?              @unique
  collection        Collection?          @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([tenantId, documentRequestId])
  @@index([homeownerId, createdAt])
  @@index([status, createdAt])
  @@index([billId])
  @@index([tenantId, documentRequestId])
  @@index([reviewedById])
  @@index([tenantId])
}

model ChatConversation {
  tenantId      String            @default("tenant_pagsibol4b_default")
  id            String            @id @default(cuid())
  subject       String?
  homeownerId   String?
  homeowner     User?             @relation("ChatConversationHomeowner", fields: [homeownerId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?             @relation("ChatConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User              @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastMessageAt DateTime?
  participants  ChatParticipant[]
  messages      ChatMessage[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([homeownerId, lastMessageAt])
  @@index([assignedToId, lastMessageAt])
  @@index([createdById])
  @@index([tenantId])
}

model ChatParticipant {
  tenantId       String           @default("tenant_pagsibol4b_default")
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  deletedAt      DateTime?
  pinnedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([conversationId, userId])
  @@index([userId, deletedAt])
  @@index([pinnedAt])
  @@index([tenantId])
}

model ChatMessage {
  tenantId              String           @default("tenant_pagsibol4b_default")
  id                    String           @id @default(cuid())
  conversationId        String
  conversation          ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId              String
  sender                User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body                  String?
  attachmentUrl         String?
  attachmentName        String?
  attachmentContentType String?
  replyToId             String?
  replyTo               ChatMessage?     @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               ChatMessage[]    @relation("ChatMessageReplies")
  attachments           ChatAttachment[]
  deletedForEveryoneAt  DateTime?
  createdAt             DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
  @@index([tenantId])
}

model ChatAttachment {
  tenantId    String      @default("tenant_pagsibol4b_default")
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url         String
  fileName    String
  contentType String
  size        Int
  createdAt   DateTime    @default(now())

  @@index([messageId])
  @@index([contentType])
  @@index([tenantId])
}

model UserPresence {
  tenantId   String   @default("tenant_pagsibol4b_default")
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  context    String?

  @@index([tenantId])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  action    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
}
