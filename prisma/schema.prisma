generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  HOA_ADMIN
  BILLING_MANAGER
  PAYROLL_MANAGER
  STAFF
  SYSTEM_ADMIN
  ADMIN
  HOMEOWNER
  EMPLOYEE
}

enum TenantModule {
  BILLING
  PAYROLL
  ATTENDANCE
  DOCUMENTS
  REPORTS
  CHAT
  ANNOUNCEMENTS
  EVENTS
  COMPLAINTS
  VEHICLES
  VISITORS
  CONTRACTORS
  CONSTRUCTION
  FACILITY_RESERVATION
  LOANS
  CASH_ADVANCE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum HomeownerStatus {
  ACTIVE
  INACTIVE
}

enum BillStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
}

enum RecurringChargeType {
  MONTHLY_DUES
  SECURITY_FEE
  MAINTENANCE_FEE
  GARBAGE_FEE
  OTHER
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BillingGenerationMode {
  MANUAL
  AUTOMATIC
}

enum BillingPenaltyType {
  NONE
  FIXED
  PERCENTAGE
}

enum BillingPenaltyFrequency {
  NONE
  MONTHLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  CHECK
  OTHER
}

enum PaymentStatus {
  ACTIVE
  VOIDED
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

enum CollectionType {
  GATE_PASS
  STICKER
  MEMBERSHIP
  CONSTRUCTION_BOND
  CONTRACTOR_BOND
  OTHER
}

enum PayerType {
  HOMEOWNER
  CONTRACTOR
}

enum RefundStatus {
  NOT_APPLICABLE
  HELD
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryType {
  DAILY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  PAID_LEAVE
  UNPAID_LEAVE
  HOLIDAY
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollAccessRole {
  PAYROLL_MANAGER
  PAYROLL_STAFF
  HR_ADMIN
  FINANCE_APPROVER
  SYSTEM_ADMINISTRATOR
  READ_ONLY_AUDITOR
}

enum PayrollDayType {
  REGULAR_HOLIDAY
  SPECIAL_NON_WORKING_HOLIDAY
  SPECIAL_WORKING_HOLIDAY
  HOA_DECLARED_HOLIDAY
  WORKING_DAY
  NON_WORKING_DAY
}

enum AttendanceAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OvertimeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum OvertimeSource {
  APPROVED_REQUEST
  PAYROLL_MANAGER_ADJUSTMENT
}

enum EmployeeLoanType {
  CASH_ADVANCE
  LOAN
  OTHER
}

enum EmployeeLoanStatus {
  OPEN
  PAID
  CANCELLED
}

enum NotificationType {
  ANNOUNCEMENT
  BILL_REMINDER
  PASSWORD_RESET
  WELCOME
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  PAYMENT_CONFIRMATION
  BILLING_NOTIFICATION
  TEST_EMAIL
  EVENT
}

enum NotificationChannel {
  EMAIL
  MESSENGER
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum FacebookPostStatus {
  NOT_REQUESTED
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum SystemSettingCategory {
  ASSOCIATION
  DATABASE
  EMAIL
  FACEBOOK
  PAYMENT
  CHAT
}

enum PaymentRequestType {
  MONTHLY_DUES
  OTHER_COLLECTION
}

enum PaymentRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DataMigrationKind {
  DUES_OPENING_BALANCE
  CONSTRUCTION_BOND_OPENING_BALANCE
  CONTRACTOR_BOND_OPENING_BALANCE
  DUES_PREVIOUS_COLLECTION
  CONSTRUCTION_BOND_PREVIOUS_COLLECTION
  CONTRACTOR_BOND_PREVIOUS_COLLECTION
  CONSTRUCTION_BOND_REFUND
  CONTRACTOR_BOND_REFUND
  CONSTRUCTION_BOND_FORFEITURE
  CONTRACTOR_BOND_FORFEITURE
}

enum DataMigrationTag {
  MIGRATED
  OPENING_BALANCE
  PREVIOUS_COLLECTION
}

enum DataMigrationStatus {
  VALIDATED
  POSTED
}

enum DocumentType {
  CERTIFICATE_OF_RESIDENCY
  CERTIFICATE_OF_GOOD_STANDING
  CLEARANCE_CERTIFICATE
  PAYMENT_CERTIFICATION
  CONSTRUCTION_BOND_CERTIFICATION
  CONTRACTOR_BOND_CERTIFICATION
  GATE_PASS
  MOVE_IN_OUT_PASS
}

enum DocumentRequestStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PENDING_APPROVAL
  UNDER_REVIEW
  APPROVED
  REJECTED
  READY_FOR_DOWNLOAD
  GENERATED
  DOWNLOADED
  CANCELLED
}

enum DocumentOrigin {
  HOMEOWNER
  ADMIN
}

enum DocumentSubjectType {
  SELF
  HOUSEHOLD_MEMBER
}

enum DocumentDeliveryMode {
  INSTANT_DOWNLOAD
  APPROVAL_REQUIRED
  PAYMENT_REQUIRED
  PAYMENT_AND_APPROVAL_REQUIRED
  REQUEST_ONLY
}

enum DocumentFieldType {
  TEXT
  TEXTAREA
  DATE
  NUMBER
  MONEY
  SELECT
  CHECKBOX
}

enum DocumentDefinitionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentTemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum DocumentVerificationStatus {
  VALID
  REVOKED
}

enum DocumentSequenceScope {
  ANNUAL
  CONTINUOUS
}

model Tenant {
  id                    String                    @id @default(cuid())
  name                  String
  shortName             String
  slug                  String                    @unique
  logoUrl               String?
  address               String?                   @db.Text
  contactNumber         String?
  email                 String?
  secRegistrationNumber String?
  tinNumber             String?
  status                TenantStatus              @default(ACTIVE)
  subscriptionPlan      String                    @default("STANDARD")
  subscriptionStatus    TenantSubscriptionStatus  @default(TRIAL)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  users                 User[]
  moduleEntitlements    TenantModuleEntitlement[]
  advisories            TenantAdvisory[]
  sequences             TenantSequence[]
  userRoleAssignments   UserRoleAssignment[]
  billingRules          BillingRule[]
  paymentAllocations    PaymentAllocation[]
  documentDefinitions   DocumentDefinition[]
  documentTemplateSets  DocumentTemplateSet[]
  documentTemplateVersions DocumentTemplateVersion[]
  documentDefinitionCounters DocumentDefinitionCounter[]
  documentVerificationTokens DocumentVerificationToken[]

  @@index([name])
  @@index([status, subscriptionStatus])
  @@index([subscriptionPlan, subscriptionStatus])
}

model User {
  tenantId                          String                       @default("tenant_pagsibol4b_default")
  id                                String                       @id @default(cuid())
  name                              String
  email                             String
  username                          String?
  passwordHash                      String
  role                              Role                         @default(HOMEOWNER)
  active                            Boolean                      @default(true)
  lastLoginAt                       DateTime?
  homeownerProfile                  HomeownerProfile?
  employeeProfile                   EmployeeProfile?             @relation("EmployeeUser")
  announcementsCreated              Announcement[]               @relation("AnnouncementCreator")
  eventsCreated                     Event[]                      @relation("EventCreator")
  notificationLogs                  NotificationLog[]            @relation("NotificationRecipient")
  collectionsCreated                Collection[]                 @relation("CollectionCreator")
  refundsProcessed                  BondRefund[]                 @relation("RefundProcessor")
  forfeituresProcessed              Collection[]                 @relation("ForfeitureProcessor")
  payrollPeriodsCreated             PayrollPeriod[]              @relation("PayrollCreator")
  expensesCreated                   Expense[]                    @relation("ExpenseCreator")
  duesExemptionsCreated             DuesExemption[]              @relation("DuesExemptionCreator")
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  systemSettingsUpdated             SystemSetting[]              @relation("SystemSettingUpdater")
  paymentRequestsReviewed           PaymentRequest[]             @relation("PaymentRequestReviewer")
  payrollAccesses                   PayrollAccess[]              @relation("PayrollAccessUser")
  payrollAccessGranted              PayrollAccess[]              @relation("PayrollAccessGrantedBy")
  auditLogs                         AuditLog[]                   @relation("AuditActor")
  calendarDaysCreated               PayrollCalendarDay[]         @relation("PayrollCalendarCreator")
  schedulesCreated                  EmployeeSchedule[]           @relation("EmployeeScheduleCreator")
  attendanceAdjustmentsRequested    AttendanceAdjustment[]       @relation("AttendanceAdjustmentRequester")
  attendanceAdjustmentsReviewed     AttendanceAdjustment[]       @relation("AttendanceAdjustmentReviewer")
  overtimeRecordsCreated            OvertimeRecord[]             @relation("OvertimeRecordCreator")
  overtimeRecordsReviewed           OvertimeRecord[]             @relation("OvertimeRecordReviewer")
  payrollArchivesDeleted            PayrollArchive[]             @relation("PayrollArchiveDeletedBy")
  billsArchived                     Bill[]                       @relation("BillArchivedBy")
  paymentsVoided                    Payment[]                    @relation("PaymentVoidedBy")
  paymentsProcessed                 Payment[]                    @relation("PaymentProcessor")
  paymentArchivesVoided             PaymentArchive[]             @relation("PaymentArchiveVoidedBy")
  dataMigrationsCreated             DataMigration[]              @relation("DataMigrationCreator")
  billingRulesCreated               BillingRule[]                @relation("BillingRuleCreator")
  billingRulesUpdated               BillingRule[]                @relation("BillingRuleUpdater")
  documentTemplatesUpdated          DocumentTemplate[]           @relation("DocumentTemplateUpdater")
  documentTypeConfigurationsUpdated DocumentTypeConfiguration[]  @relation("DocumentTypeConfigurationUpdater")
  documentRequestsProcessed         DocumentRequest[]            @relation("DocumentRequestProcessor")
  documentRequestsApproved          DocumentRequest[]            @relation("DocumentRequestApprover")
  documentDownloadOverrides         DocumentRequest[]            @relation("DocumentDownloadOverride")
  documentRequestsInitiated         DocumentRequest[]            @relation("DocumentInitiator")
  documentRequestsArchived          DocumentRequest[]            @relation("DocumentArchiver")
  documentRequestEditAudits         DocumentRequestEditAudit[]   @relation("DocumentRequestEditAuditActor")
  documentVersionsGenerated         DocumentVersion[]            @relation("DocumentVersionGenerator")
  documentRequestHistory            DocumentRequestHistory[]     @relation("DocumentRequestHistoryActor")
  documentDefinitionsCreated        DocumentDefinition[]         @relation("DocumentDefinitionCreator")
  documentDefinitionsUpdated        DocumentDefinition[]         @relation("DocumentDefinitionUpdater")
  documentTemplateVersionsCreated   DocumentTemplateVersion[]    @relation("DocumentTemplateVersionCreator")
  documentTemplateVersionsPublished DocumentTemplateVersion[]    @relation("DocumentTemplateVersionPublisher")
  documentVerificationTokensRevoked DocumentVerificationToken[]   @relation("DocumentVerificationTokenRevoker")
  organizationOfficersUpdated       OrganizationOfficer[]        @relation("OrganizationOfficerUpdater")
  organizationHistoryCreated        OrganizationOfficerHistory[] @relation("OrganizationOfficerHistoryActor")
  chatConversationsHomeowner        ChatConversation[]           @relation("ChatConversationHomeowner")
  chatConversationsCreated          ChatConversation[]           @relation("ChatConversationCreator")
  chatConversationsAssigned         ChatConversation[]           @relation("ChatConversationAssignee")
  chatParticipants                  ChatParticipant[]
  chatMessages                      ChatMessage[]                @relation("ChatMessageSender")
  presence                          UserPresence?
  passwordResetTokens               PasswordResetToken[]
  userRoleAssignments               UserRoleAssignment[]
  assignedRoleAssignments           UserRoleAssignment[]         @relation("UserRoleAssignmentAssignedBy")
  tenant                            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([role])
  @@index([tenantId, active, role])
  @@index([tenantId])
}

model UserRoleAssignment {
  tenantId       String
  userId         String
  role           Role
  assignedBy     String?
  assignedAt     DateTime @default(now())
  active         Boolean  @default(true)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("UserRoleAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([tenantId, userId, role])
  @@index([tenantId, active, role])
  @@index([userId, active])
}

model TenantModuleEntitlement {
  id        String       @id @default(cuid())
  tenantId  String
  module    TenantModule
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, enabled])
}

model TenantAdvisory {
  id        String   @id @default(cuid())
  tenantId  String
  message   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model TenantSequence {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String
  year      Int
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, year])
}

model HomeownerProfile {
  tenantId          String            @default("tenant_pagsibol4b_default")
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  address           String
  block             String
  lot               String
  phone             String
  birthDate         DateTime?         @db.Date
  civilStatus       String?
  citizenship       String?
  occupation        String?
  residencyDate     DateTime?         @db.Date
  phase             String?
  propertyType      String?
  occupancyStatus   String?
  messengerId       String?
  status            HomeownerStatus   @default(ACTIVE)
  monthlyDuesAmount Decimal           @db.Decimal(12, 2)
  bills             Bill[]
  payments          Payment[]
  paymentRequests   PaymentRequest[]
  collections       Collection[]
  duesExemptions    DuesExemption[]
  vehicles          Vehicle[]
  dataMigrations    DataMigration[]
  documentRequests  DocumentRequest[]
  householdMembers  HouseholdMember[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, block, lot])
  @@index([status])
  @@index([tenantId])
}

model ContractorProfile {
  tenantId       String           @default("tenant_pagsibol4b_default")
  id             String           @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String?
  phone          String
  address        String
  licenseNumber  String?
  status         ContractorStatus @default(ACTIVE)
  collections    Collection[]
  dataMigrations DataMigration[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, companyName])
  @@index([companyName])
  @@index([status])
  @@index([tenantId])
}

model Bill {
  tenantId            String              @default("tenant_pagsibol4b_default")
  id                  String              @id @default(cuid())
  homeownerId         String
  homeowner           HomeownerProfile    @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  billingMonth        DateTime            @db.Date
  recurringChargeType RecurringChargeType @default(MONTHLY_DUES)
  coverageYear        Int
  coverageMonth       Int
  billingRuleId       String?
  billingRule         BillingRule?        @relation(fields: [billingRuleId], references: [id], onDelete: SetNull)
  billingRuleSnapshot Json?
  resolutionReference String?
  amount              Decimal             @db.Decimal(12, 2)
  penalty             Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal             @db.Decimal(12, 2)
  amountPaid          Decimal             @default(0) @db.Decimal(12, 2)
  balance             Decimal             @db.Decimal(12, 2)
  dueDate             DateTime            @db.Date
  status              BillStatus          @default(UNPAID)
  notes               String?             @db.Text
  payments            Payment[]
  paymentAllocations  PaymentAllocation[]
  paymentRequests     PaymentRequest[]
  archivedAt          DateTime?
  archivedById        String?
  archivedBy          User?               @relation("BillArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveReason       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([homeownerId, billingMonth])
  @@unique([tenantId, homeownerId, recurringChargeType, coverageYear, coverageMonth])
  @@unique([tenantId, id])
  @@index([status, dueDate])
  @@index([billingMonth])
  @@index([tenantId, recurringChargeType, coverageYear, coverageMonth])
  @@index([billingRuleId])
  @@index([archivedAt, status, dueDate])
  @@index([archivedById])
  @@index([tenantId])
}

model BillingRule {
  tenantId            String
  id                  String                  @id @default(cuid())
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recurringChargeType RecurringChargeType     @default(MONTHLY_DUES)
  amount              Decimal                 @db.Decimal(12, 2)
  billingFrequency    BillingFrequency        @default(MONTHLY)
  generationMode      BillingGenerationMode   @default(MANUAL)
  billingDay          Int                     @default(1)
  dueDay              Int                     @default(15)
  gracePeriodDays     Int                     @default(0)
  penaltyType         BillingPenaltyType      @default(NONE)
  penaltyValue        Decimal                 @default(0) @db.Decimal(12, 2)
  penaltyFrequency    BillingPenaltyFrequency @default(NONE)
  effectiveStartYear  Int
  effectiveStartMonth Int
  effectiveEndYear    Int?
  effectiveEndMonth   Int?
  resolutionReference String
  resolutionDate      DateTime?               @db.Date
  notes               String?                 @db.Text
  active              Boolean                 @default(true)
  createdById         String?
  createdBy           User?                   @relation("BillingRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById         String?
  updatedBy           User?                   @relation("BillingRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  bills               Bill[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([tenantId, recurringChargeType, active, effectiveStartYear, effectiveStartMonth])
  @@index([tenantId, recurringChargeType, effectiveEndYear, effectiveEndMonth])
  @@index([createdById])
  @@index([updatedById])
}

model DuesExemption {
  tenantId            String              @default("tenant_pagsibol4b_default")
  id                  String              @id @default(cuid())
  homeownerId         String
  homeowner           HomeownerProfile    @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  recurringChargeType RecurringChargeType @default(MONTHLY_DUES)
  billingMonth        DateTime            @db.Date
  startYear           Int
  startMonth          Int
  endYear             Int
  endMonth            Int
  reason              String
  resolutionReference String?
  approvedBy          String?
  active              Boolean             @default(true)
  createdById         String
  createdBy           User                @relation("DuesExemptionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById         String?
  deactivatedAt       DateTime?
  deactivatedById     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([homeownerId, billingMonth])
  @@index([tenantId, homeownerId, recurringChargeType, active, startYear, startMonth, endYear, endMonth])
  @@index([billingMonth])
  @@index([tenantId])
}

model Payment {
  tenantId               String              @default("tenant_pagsibol4b_default")
  id                     String              @id @default(cuid())
  billId                 String?
  bill                   Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  homeownerId            String
  homeowner              HomeownerProfile    @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  amount                 Decimal             @db.Decimal(12, 2)
  paymentDate            DateTime            @db.Date
  method                 PaymentMethod
  referenceNumber        String?
  paymentBatchId         String?
  idempotencyKey         String?
  coverageStart          DateTime?           @db.Date
  coverageEnd            DateTime?           @db.Date
  coverageMonths         Json?
  coverageFromMonth      Int?
  coverageFromYear       Int?
  coverageToMonth        Int?
  coverageToYear         Int?
  paymentCoverageDisplay String?
  remarks                String?
  receiptNumber          String?
  proofUrl               String?
  proofFileName          String?
  proofContentType       String?
  proofFileSize          Int?
  status                 PaymentStatus       @default(ACTIVE)
  voidedAt               DateTime?
  voidedById             String?
  voidedBy               User?               @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason             String?
  processedById          String?
  processedBy            User?               @relation("PaymentProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  paymentRequest         PaymentRequest?
  allocations            PaymentAllocation[]
  createdAt              DateTime            @default(now())

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([homeownerId, paymentDate])
  @@index([billId])
  @@index([status, paymentDate])
  @@index([paymentBatchId])
  @@index([voidedById])
  @@index([processedById])
  @@index([tenantId])
}

model PaymentAllocation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentId     String
  payment       Payment  @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  billId        String
  bill          Bill     @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  coverageYear  Int?
  coverageMonth Int?
  coverageLabel String?
  createdAt     DateTime @default(now())

  @@unique([paymentId, billId])
  @@index([tenantId, paymentId])
  @@index([tenantId, billId])
}

model PaymentArchive {
  tenantId               String        @default("tenant_pagsibol4b_default")
  id                     String        @id @default(cuid())
  originalPaymentId      String        @unique
  billId                 String
  billingMonth           DateTime      @db.Date
  homeownerId            String
  homeownerName          String
  homeownerAddress       String
  property               String
  amount                 Decimal       @db.Decimal(12, 2)
  paymentDate            DateTime      @db.Date
  method                 PaymentMethod
  referenceNumber        String?
  paymentBatchId         String?
  coverageStart          DateTime?     @db.Date
  coverageEnd            DateTime?     @db.Date
  coverageMonths         Json?
  coverageFromMonth      Int?
  coverageFromYear       Int?
  coverageToMonth        Int?
  coverageToYear         Int?
  paymentCoverageDisplay String?
  receiptNumber          String?
  remarks                String?
  proofUrl               String?
  proofFileName          String?
  proofContentType       String?
  proofFileSize          Int?
  originalCreatedAt      DateTime
  voidedById             String
  voidedBy               User          @relation("PaymentArchiveVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidedAt               DateTime      @default(now())
  voidReason             String?

  @@index([voidedAt])
  @@index([homeownerId, paymentDate])
  @@index([billId])
  @@index([paymentBatchId])
  @@index([voidedById])
  @@index([tenantId])
}

model Collection {
  tenantId        String             @default("tenant_pagsibol4b_default")
  id              String             @id @default(cuid())
  type            CollectionType
  description     String?
  payerType       PayerType
  homeownerId     String?
  homeowner       HomeownerProfile?  @relation(fields: [homeownerId], references: [id], onDelete: Restrict)
  contractorId    String?
  contractor      ContractorProfile? @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  amount          Decimal            @db.Decimal(12, 2)
  collectionDate  DateTime           @db.Date
  method          PaymentMethod
  referenceNumber String?
  receiptNumber   String?
  remarks         String?
  refundable      Boolean            @default(false)
  amountRefunded  Decimal            @default(0) @db.Decimal(12, 2)
  amountForfeited Decimal            @default(0) @db.Decimal(12, 2)
  refundStatus    RefundStatus       @default(NOT_APPLICABLE)
  forfeitedAt     DateTime?          @db.Date
  forfeitedById   String?
  forfeitedBy     User?              @relation("ForfeitureProcessor", fields: [forfeitedById], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User               @relation("CollectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  refunds         BondRefund[]
  vehicle         Vehicle?
  paymentRequest  PaymentRequest?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, receiptNumber])
  @@index([type, collectionDate])
  @@index([homeownerId, collectionDate])
