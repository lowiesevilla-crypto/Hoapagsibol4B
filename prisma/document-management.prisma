enum RepositoryDocumentVisibility {
  INTERNAL
  TENANT_PUBLIC
  RESTRICTED
}

enum RepositoryDocumentStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  ARCHIVED
}

enum RepositoryDocumentRevisionPolicy {
  REPLACE_CURRENT
  KEEP_HISTORY
}

enum RepositoryMalwareScanStatus {
  NOT_CONFIGURED
  PENDING
  PASSED
  FAILED
  BLOCKED
}

/// Commercial feature settings attached to a subscription plan without
/// overloading TenantModule.DOCUMENTS, which belongs to generated documents.
/// Feature codes are strings so future capabilities (for example AI_ASSISTANCE)
/// can use the same entitlement mechanism without enum/schema churn.
model SubscriptionPlanFeatureEntitlement {
  planId                 String
  featureCode            String   @db.VarChar(80)
  enabled                Boolean  @default(false)
  storageLimitMb         Int?
  maxFileSizeMb          Int?     @default(25)
  retainRevisionBinaries Boolean  @default(false)
  maxRevisionBinaries    Int?
  configuration          Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@id([planId, featureCode])
  @@index([featureCode, enabled])
}

/// Tenant-specific commercial overrides. Absence of a row means inherit the
/// active subscription plan. Nullable override fields intentionally preserve
/// plan inheritance. configurationOverride is a feature-specific partial
/// configuration object merged by the corresponding feature service.
model TenantFeatureEntitlement {
  tenantId                        String
  featureCode                     String   @db.VarChar(80)
  enabledOverride                 Boolean?
  storageLimitMbOverride          Int?
  maxFileSizeMbOverride           Int?
  retainRevisionBinariesOverride  Boolean?
  maxRevisionBinariesOverride     Int?
  configurationOverride           Json?
  updatedById                     String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@id([tenantId, featureCode])
  @@index([tenantId, updatedAt])
  @@index([featureCode, enabledOverride])
}

model RepositoryDocumentCategory {
  id                   String               @id @default(cuid())
  tenantId             String
  code                 String               @db.VarChar(100)
  name                 String
  categoryGroup        String               @db.VarChar(60)
  description          String?              @db.Text
  active               Boolean              @default(true)
  sortOrder            Int                  @default(0)
  systemDefault        Boolean              @default(false)
  governanceControlled Boolean              @default(false)
  createdById          String?
  documents            RepositoryDocument[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active, sortOrder])
  @@index([tenantId, governanceControlled, active], map: "RepositoryCategory_governance_idx")
}

model RepositoryDocument {
  id                    String                           @id @default(cuid())
  tenantId              String
  categoryId            String
  title                 String
  description           String?                          @db.Text
  documentReference     String?                          @db.VarChar(120)
  visibility            RepositoryDocumentVisibility     @default(INTERNAL)
  status                RepositoryDocumentStatus         @default(DRAFT)
  currentRevision       Int                              @default(1)
  revisionPolicy        RepositoryDocumentRevisionPolicy @default(REPLACE_CURRENT)
  originalFileName      String
  storageKey            String                           @db.VarChar(500)
  contentType           String                           @db.VarChar(160)
  fileExtension         String                           @db.VarChar(20)
  fileSizeBytes         BigInt
  checksumSha256        String                           @db.VarChar(64)
  malwareScanStatus     RepositoryMalwareScanStatus      @default(NOT_CONFIGURED)
  aiEnabled             Boolean                          @default(false)
  privacyClassification AiPrivacyClassification          @default(INTERNAL)
  issuingBody           String?
  approvalDate          DateTime?                        @db.Date
  effectiveAt           DateTime?
  expiresAt             DateTime?
  publishedAt           DateTime?
  resolutionNumber      String?                          @db.VarChar(120)
  memoNumber            String?                          @db.VarChar(120)
  policyOwner           String?
  remarks               String?                          @db.Text
  searchableKeywords    String?                          @db.Text
  uploadedById          String
  updatedById           String?
  category              RepositoryDocumentCategory       @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  revisions             RepositoryDocumentRevision[]
  tagAssignments        RepositoryDocumentTagAssignment[]
  aiKnowledgeBinding    AiKnowledgeBinding?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, storageKey])
  @@index([tenantId, status, visibility, updatedAt])
  @@index([tenantId, aiEnabled, status, visibility], map: "RepositoryDocument_ai_eligibility_idx")
  @@index([tenantId, privacyClassification, aiEnabled], map: "RepositoryDocument_privacy_ai_idx")
  @@index([tenantId, categoryId, status])
  @@index([tenantId, documentReference])
  @@index([tenantId, effectiveAt, expiresAt])
  @@index([tenantId, uploadedById, createdAt])
}

/// Historical binaries are optional. When a plan/policy purges an old binary,
/// storageKey becomes null while immutable revision metadata remains available
/// until the repository document itself is permanently deleted. AuditLog keeps
/// the deletion/replacement evidence after permanent document deletion.
model RepositoryDocumentRevision {
  id                String                      @id @default(cuid())
  tenantId          String
  documentId        String
  revision          Int
  revisionLabel     String?                     @db.VarChar(60)
  originalFileName  String
  storageKey        String?                     @db.VarChar(500)
  contentType       String                      @db.VarChar(160)
  fileExtension     String                      @db.VarChar(20)
  fileSizeBytes     BigInt
  checksumSha256    String                      @db.VarChar(64)
  malwareScanStatus RepositoryMalwareScanStatus @default(NOT_CONFIGURED)
  reason            String?                     @db.Text
  createdById       String
  document          RepositoryDocument          @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  createdAt         DateTime                    @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, revision])
  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, storageKey])
}

model RepositoryDocumentTag {
  id          String                            @id @default(cuid())
  tenantId    String
  name        String                            @db.VarChar(100)
  assignments RepositoryDocumentTagAssignment[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model RepositoryDocumentTagAssignment {
  tenantId   String
  documentId String
  tagId      String
  document   RepositoryDocument    @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  tag        RepositoryDocumentTag @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime              @default(now())

  @@id([tenantId, documentId, tagId])
  @@index([tenantId, tagId, documentId])
}
