model Tenant {
  id                         String                               @id @default(cuid())
  name                       String
  shortName                  String
  slug                       String                               @unique
  logoUrl                    String?
  address                    String?                              @db.Text
  contactNumber              String?
  email                      String?
  secRegistrationNumber      String?
  tinNumber                  String?
  status                     TenantStatus                         @default(ACTIVE)
  subscriptionPlan           String                               @default("STANDARD")
  subscriptionStatus         TenantSubscriptionStatus             @default(TRIAL)
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  users                      User[]
  moduleEntitlements         TenantModuleEntitlement[]
  advisories                 TenantAdvisory[]
  sequences                  TenantSequence[]
  userRoleAssignments        UserRoleAssignment[]
  customRoles                TenantCustomRole[]
  customRolePermissions      TenantCustomRolePermission[]
  customRoleAssignments      UserTenantCustomRoleAssignment[]
  billingRules               BillingRule[]
  paymentAllocations         PaymentAllocation[]
  documentDefinitions        DocumentDefinition[]
  documentTemplateSets       DocumentTemplateSet[]
  documentTemplateVersions   DocumentTemplateVersion[]
  documentDefinitionCounters DocumentDefinitionCounter[]
  documentVerificationTokens DocumentVerificationToken[]
  documentGenerationAttempts DocumentGenerationAttempt[]
  documentPolicies           DocumentPolicy[]
  documentPolicyAssignments  DocumentDefinitionPolicyAssignment[]
  documentWorkflows          DocumentWorkflowDefinition[]
  documentWorkflowSteps      DocumentWorkflowStep[]
  documentNumberingConfigs   DocumentNumberingConfiguration[]
  documentPlaceholders       DocumentPlaceholderDefinition[]
  complaintSettings          ComplaintSetting?
  complaintCategories        ComplaintCategory[]
  complaints                 Complaint[]
  complaintIdentities        ComplaintConfidentialIdentity[]
  complaintCredentials       ComplaintTrackingCredential[]
  complaintAttachments       ComplaintAttachment[]
  complaintMessages          ComplaintMessage[]
  complaintStatusHistory     ComplaintStatusHistory[]
  complaintTimelineEvents    ComplaintTimelineEvent[]
  complaintAssignments       ComplaintAssignment[]
  complaintIdentityAccess    ComplaintIdentityAccessGrant[]

  @@index([name])
  @@index([status, subscriptionStatus])
  @@index([subscriptionPlan, subscriptionStatus])
}

model User {
  tenantId                              String                            @default("tenant_pagsibol4b_default")
  id                                    String                            @id @default(cuid())
  name                                  String
  email                                 String
  username                              String?
  passwordHash                          String
  role                                  Role                              @default(HOMEOWNER)
  active                                Boolean                           @default(true)
  lastLoginAt                           DateTime?
  homeownerProfile                      HomeownerProfile?
  employeeProfile                       EmployeeProfile?                  @relation("EmployeeUser")
  announcementsCreated                  Announcement[]                    @relation("AnnouncementCreator")
  eventsCreated                         Event[]                           @relation("EventCreator")
  notificationLogs                      NotificationLog[]                 @relation("NotificationRecipient")
  collectionsCreated                    Collection[]                      @relation("CollectionCreator")
  refundsProcessed                      BondRefund[]                      @relation("RefundProcessor")
  forfeituresProcessed                  Collection[]                      @relation("ForfeitureProcessor")
  payrollPeriodsCreated                 PayrollPeriod[]                   @relation("PayrollCreator")
  expensesCreated                       Expense[]                         @relation("ExpenseCreator")
  duesExemptionsCreated                 DuesExemption[]                   @relation("DuesExemptionCreator")
  createdAt                             DateTime                          @default(now())
  updatedAt                             DateTime                          @updatedAt
  systemSettingsUpdated                 SystemSetting[]                   @relation("SystemSettingUpdater")
  paymentRequestsReviewed               PaymentRequest[]                  @relation("PaymentRequestReviewer")
  payrollAccesses                       PayrollAccess[]                   @relation("PayrollAccessUser")
  payrollAccessGranted                  PayrollAccess[]                   @relation("PayrollAccessGrantedBy")
  auditLogs                             AuditLog[]                        @relation("AuditActor")
  calendarDaysCreated                   PayrollCalendarDay[]              @relation("PayrollCalendarCreator")
  schedulesCreated                      EmployeeSchedule[]                @relation("EmployeeScheduleCreator")
  attendanceAdjustmentsRequested        AttendanceAdjustment[]            @relation("AttendanceAdjustmentRequester")
  attendanceAdjustmentsReviewed         AttendanceAdjustment[]            @relation("AttendanceAdjustmentReviewer")
  overtimeRecordsCreated                OvertimeRecord[]                  @relation("OvertimeRecordCreator")
  overtimeRecordsReviewed               OvertimeRecord[]                  @relation("OvertimeRecordReviewer")
  payrollArchivesDeleted                PayrollArchive[]                  @relation("PayrollArchiveDeletedBy")
  billsArchived                         Bill[]                            @relation("BillArchivedBy")
  paymentsVoided                        Payment[]                         @relation("PaymentVoidedBy")
  paymentsProcessed                     Payment[]                         @relation("PaymentProcessor")
  paymentArchivesVoided                 PaymentArchive[]                  @relation("PaymentArchiveVoidedBy")
  dataMigrationsCreated                 DataMigration[]                   @relation("DataMigrationCreator")
  billingRulesCreated                   BillingRule[]                     @relation("BillingRuleCreator")
  billingRulesUpdated                   BillingRule[]                     @relation("BillingRuleUpdater")
  documentTemplatesUpdated              DocumentTemplate[]                @relation("DocumentTemplateUpdater")
  documentTypeConfigurationsUpdated     DocumentTypeConfiguration[]       @relation("DocumentTypeConfigurationUpdater")
  documentRequestsProcessed             DocumentRequest[]                 @relation("DocumentRequestProcessor")
  documentRequestsApproved              DocumentRequest[]                 @relation("DocumentRequestApprover")
  documentDownloadOverrides             DocumentRequest[]                 @relation("DocumentDownloadOverride")
  documentRequestsInitiated             DocumentRequest[]                 @relation("DocumentInitiator")
  documentRequestsArchived              DocumentRequest[]                 @relation("DocumentArchiver")
  documentRequestEditAudits             DocumentRequestEditAudit[]        @relation("DocumentRequestEditAuditActor")
  documentVersionsGenerated             DocumentVersion[]                 @relation("DocumentVersionGenerator")
  documentVersionsReleased              DocumentVersion[]                 @relation("DocumentVersionReleaser")
  documentVersionsRevoked               DocumentVersion[]                 @relation("DocumentVersionRevoker")
  documentRequestHistory                DocumentRequestHistory[]          @relation("DocumentRequestHistoryActor")
  documentDefinitionsCreated            DocumentDefinition[]              @relation("DocumentDefinitionCreator")
  documentDefinitionsUpdated            DocumentDefinition[]              @relation("DocumentDefinitionUpdater")
  documentTemplateVersionsCreated       DocumentTemplateVersion[]         @relation("DocumentTemplateVersionCreator")
  documentTemplateVersionsPublished     DocumentTemplateVersion[]         @relation("DocumentTemplateVersionPublisher")
  documentVerificationTokensRevoked     DocumentVerificationToken[]       @relation("DocumentVerificationTokenRevoker")
  documentGenerationAttempts            DocumentGenerationAttempt[]       @relation("DocumentGenerationAttemptActor")
  documentWorkflowDefinitionsCreated    DocumentWorkflowDefinition[]      @relation("DocumentWorkflowDefinitionCreator")
  documentWorkflowDefinitionsUpdated    DocumentWorkflowDefinition[]      @relation("DocumentWorkflowDefinitionUpdater")
  documentWorkflowStepsCreated          DocumentWorkflowStep[]            @relation("DocumentWorkflowStepCreator")
  documentWorkflowStepsUpdated          DocumentWorkflowStep[]            @relation("DocumentWorkflowStepUpdater")
  documentPoliciesCreated               DocumentPolicy[]                  @relation("DocumentPolicyCreator")
  documentPoliciesUpdated               DocumentPolicy[]                  @relation("DocumentPolicyUpdater")
  documentNumberingConfigsCreated       DocumentNumberingConfiguration[]  @relation("DocumentNumberingConfigurationCreator")
  documentNumberingConfigsUpdated       DocumentNumberingConfiguration[]  @relation("DocumentNumberingConfigurationUpdater")
  documentPlaceholderDefinitionsCreated DocumentPlaceholderDefinition[]   @relation("DocumentPlaceholderDefinitionCreator")
  documentPlaceholderDefinitionsUpdated DocumentPlaceholderDefinition[]   @relation("DocumentPlaceholderDefinitionUpdater")
  documentWorkflowApproverSteps         DocumentWorkflowStep[]            @relation("DocumentWorkflowStepApprover")
  organizationOfficersUpdated           OrganizationOfficer[]             @relation("OrganizationOfficerUpdater")
  organizationHistoryCreated            OrganizationOfficerHistory[]      @relation("OrganizationOfficerHistoryActor")
  chatConversationsHomeowner            ChatConversation[]                @relation("ChatConversationHomeowner")
  chatConversationsCreated              ChatConversation[]                @relation("ChatConversationCreator")
  chatConversationsAssigned             ChatConversation[]                @relation("ChatConversationAssignee")
  chatParticipants                      ChatParticipant[]
  chatMessages                          ChatMessage[]                     @relation("ChatMessageSender")
  presence                              UserPresence?
  passwordResetTokens                   PasswordResetToken[]
  homeownerActivationCredentials        HomeownerActivationCredential[]   @relation("HomeownerActivationUser")
  homeownerActivationCredentialsCreated HomeownerActivationCredential[]   @relation("HomeownerActivationCreator")
  homeownerEmailVerificationTokens      HomeownerEmailVerificationToken[]
  passkeyCredentials                    UserPasskeyCredential[]
  passkeyChallenges                     UserPasskeyChallenge[]
  sessions                              UserSession[]
  complaintsSubmitted                   Complaint[]                       @relation("ComplaintSubmitter")
  complaintsAssigned                    Complaint[]                       @relation("ComplaintAssignee")
  complaintAttachmentsUploaded          ComplaintAttachment[]             @relation("ComplaintAttachmentUploader")
  complaintMessages                     ComplaintMessage[]                @relation("ComplaintMessageAuthor")
  complaintStatusChanges                ComplaintStatusHistory[]          @relation("ComplaintStatusActor")
  complaintTimelineEvents               ComplaintTimelineEvent[]          @relation("ComplaintTimelineActor")
  complaintAssignmentsReceived          ComplaintAssignment[]             @relation("ComplaintAssignmentAssignee")
  complaintAssignmentsGiven             ComplaintAssignment[]             @relation("ComplaintAssignmentAssignedBy")
  complaintIdentityAccessRequested      ComplaintIdentityAccessGrant[]    @relation("ComplaintIdentityAccessRequester")
  complaintIdentityAccessApproved       ComplaintIdentityAccessGrant[]    @relation("ComplaintIdentityAccessApprover")
  userRoleAssignments                   UserRoleAssignment[]
  assignedRoleAssignments               UserRoleAssignment[]              @relation("UserRoleAssignmentAssignedBy")
  tenantCustomRoleAssignments           UserTenantCustomRoleAssignment[]  @relation("TenantCustomRoleAssignmentUser")
  tenantCustomRoleAssignmentsGranted    UserTenantCustomRoleAssignment[]  @relation("TenantCustomRoleAssignmentAssignedBy")
  tenantCustomRolesCreated              TenantCustomRole[]                 @relation("TenantCustomRoleCreatedBy")
  tenantCustomRolesUpdated              TenantCustomRole[]                 @relation("TenantCustomRoleUpdatedBy")
  tenant                                Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([role])
  @@index([tenantId, active, role])
  @@index([tenantId])
}

model UserRoleAssignment {
  tenantId       String
  userId         String
  role           Role
  assignedBy     String?
  assignedAt     DateTime @default(now())
  active         Boolean  @default(true)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("UserRoleAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([tenantId, userId, role])
  @@index([tenantId, active, role])
  @@index([userId, active])
}

model TenantCustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   @db.VarChar(100)
  key         String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  active      Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("TenantCustomRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("TenantCustomRoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  permissions TenantCustomRolePermission[]
  assignments UserTenantCustomRoleAssignment[]

  @@unique([tenantId, name])
  @@unique([tenantId, key])
  @@index([tenantId, active])
}

model TenantCustomRolePermission {
  tenantId   String
  roleId     String
  permission String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       TenantCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, permission])
}

model UserTenantCustomRoleAssignment {
  tenantId       String
  userId         String
  roleId         String
  assignedBy     String?
  assignedAt     DateTime         @default(now())
  active         Boolean          @default(true)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User             @relation("TenantCustomRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role           TenantCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User?            @relation("TenantCustomRoleAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([tenantId, userId, roleId])
  @@index([tenantId, active, roleId])
  @@index([userId, active])
}

model TenantModuleEntitlement {
  id        String       @id @default(cuid())
  tenantId  String
  module    TenantModule
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, enabled])
}

model TenantAdvisory {
  id        String   @id @default(cuid())
  tenantId  String
  message   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model TenantSequence {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String
  year      Int
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, year])
}

model HomeownerProfile {
  tenantId            String                           @default("tenant_pagsibol4b_default")
  id                  String                           @id @default(cuid())
  userId              String                           @unique
  user                User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  address             String
  block               String
  lot                 String
  phone               String
  birthDate           DateTime?                        @db.Date
  civilStatus         String?
  citizenship         String?
  occupation          String?
  residencyDate       DateTime?                        @db.Date
  phase               String?
  propertyType        String?
  occupancyStatus     String?
  messengerId         String?
  accountNumber       String?                          @unique @db.VarChar(11)
  status              HomeownerStatus                  @default(ACTIVE)
  activationStatus    HomeownerActivationStatus        @default(NOT_INVITED)
  emailStatus         HomeownerEmailVerificationStatus @default(UNVERIFIED)
  emailVerifiedAt     DateTime?
  mobileConfirmedAt   DateTime?
  activationSentAt    DateTime?
  activatedAt         DateTime?
  monthlyDuesAmount   Decimal                          @db.Decimal(12, 2)
  bills               Bill[]
  payments            Payment[]
  paymentRequests     PaymentRequest[]
  collections         Collection[]
  duesExemptions      DuesExemption[]
  vehicles            Vehicle[]
  dataMigrations      DataMigration[]
  documentRequests    DocumentRequest[]
  householdMembers    HouseholdMember[]
  complaints          Complaint[]
  complaintIdentities ComplaintConfidentialIdentity[]
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, block, lot])
  @@index([status])
  @@index([tenantId])
}

model HomeownerAccountNumberReservation {
  tenantId      String   @default("tenant_pagsibol4b_default")
  id            String   @id @default(cuid())
  accountNumber String   @unique @db.VarChar(11)
  homeownerId   String?
  reason        String   @default("ASSIGNED")
  reservedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, homeownerId])
  @@index([tenantId])
}

model ContractorProfile {
  tenantId       String           @default("tenant_pagsibol4b_default")
  id             String           @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String?
  phone          String
  address        String
  licenseNumber  String?
  status         ContractorStatus @default(ACTIVE)
  collections    Collection[]
  dataMigrations DataMigration[]
  createdAt      DateTime         @default(now())
